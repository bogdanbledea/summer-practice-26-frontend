# Supabase → Project Settings → API
SUPABASE_URL=https://<project-ref>.supabase.co

# The service_role key. Bypasses RLS — server only, never in the frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Signs access tokens. Anyone holding it can forge a token for any account.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Seconds an access token stays valid. 900 (15 min) is a normal production
# value. Set it to 60 during the lesson so the refresh actually happens on
# screen while the students are watching the network tab.
ACCESS_TOKEN_TTL=900

# Seconds a refresh token stays valid — how long "stay logged in" lasts.
REFRESH_TOKEN_TTL=2592000

# "*" while the students work locally, or a comma-separated list of origins.
CORS_ORIGIN=*

# Railway injects PORT; only needed locally.
PORT=3000
